# judge（採点役）の Azure OpenAI エンドポイント
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
JUDGE_DEPLOYMENT=gpt-4.1

# ▼ insufficient quota でデプロイできない場合のフォールバック
#    最下位のクォータティア（Free Tier / Tier 0）にあるのは gpt-4.1-mini で、gpt-4.1 は別物です。
#    上の行をコメントアウトし、以下を使ってください。詳細は FAQ.md を参照。
#    ※ 採点役のモデルを変えると評価スコアの絶対値は変わります。傾向の比較には使えます。
# JUDGE_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
